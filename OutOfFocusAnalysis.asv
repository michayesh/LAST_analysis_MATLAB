% OutOfFocusAnalysis
% Use Eran's script

clear;
close all;

FITS_PATH = ['/home/micha/Dropbox/WAO/LAST_analysis/' ...
    'Out_of_focus_Images/LAST.01.01.03_20260430/LAST01.01.03_20260430_oof'];
ImageName = 'LAST.01.01.03_20260430.185611.750_clear_oof1500_001_001_001_sci_raw_Image_1.fits';
% f = fullfile(imagePath,ImageName);
% [ImageName, FITS_PATH] = uigetfile(fullfile(FITS_PATH,'*.fits'), ...
%                                'Select out-of-focus FITS image');
% if isequal(fname, 0)
%         error('No file selected. Aborting.');
% end
f = fullfile(FITS_PATH,ImageName);
fprintf('Opening %s',ImageName);
% Image = fitsread(f,'primary');
% R=imUtil.psf.findMeasureOutFocusAnnulus(Image,'MaxRad',100,'Angle',15, 'RingsTempBank',[11 20; 15 33; 21 50; 31 60 ;50 100]);
% SubImagesCCDSEC   =               [2701 3700 4301 5300;...
%                                    101 1100  101 1100;...
%                                    101 1100 8501 9500;...
%                                   5301 6300  101 1100;...
%                                   5301 6300 8501 9500];
SubImagesCCDSEC   =               [2951 3450 4551 5050;...
                                   251 750  251 750;...
                                   251 750 8751 9250;...
                                  5551 6050  101 1100;...
                                  5551 6050 8751 9250];
R=findMeasureOutFocusAnnulus_m(f,'MaxRad',50,'Angle',5,...
                        'HeightFactor',0.3,...
                        'SubImagesCCDSEC', SubImagesCCDSEC,...
                        'ShowFigs',true);
% plot(R(1).RadialVec, R(1).MeanSector);
fig1  = figure('Name', 'Annulus Radii', 'NumberTitle', 'off', ...
               'Position', [50 50 2000,400]);
% ax1 = axes(Parent=fig1)
for i=1:numel(R)
    subplot(1,numel(R),i);
    polarplot(deg2rad(R(i).AngleVec(:)),R(i).InnerRadius(:));
    hold on;
    polarplot(deg2rad(R(i).AngleVec(:)),R(i).OuterRadius(:));
    hold off;
end
